# === Telegram & Threads (existing) ===
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
THREADS_APP_ID=YOUR_THREADS_APP_ID
THREADS_APP_SECRET=YOUR_THREADS_APP_SECRET
REDIRECT_URI=https://YOUR-APP-NAME.koyeb.app/callback
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# === AI Engine ===
# Provider priority: gemini | groq | openrouter (fallback chain auto-tries others)
AI_PROVIDER=gemini

# Google Gemini  → https://aistudio.google.com/apikey  (15 RPM, 1500/day FREE)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq           → https://console.groq.com           (fast, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter     → https://openrouter.ai              (free models with :free suffix)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# === Auto-Reply behavior ===
AI_REPLY_ENABLED=false
AI_REPLY_STYLE=friendly
AI_REPLY_DELAY_MIN=60
AI_REPLY_DELAY_MAX=300
AI_REPLY_DAILY_LIMIT=40
AI_SKIP_TOXIC=true
